# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# --- ProofFleet Hardening (SPEC v1) ---

# HMAC secret for evidence block signatures. Without it, blocks are honestly
# sealed with signature=null (no fake signatures).
PROOFFLEET_HMAC_SECRET=""

# Operator authentication. Put these in Secret Manager / AI Studio Secrets,
# never in source. Both token and session secret are required; otherwise
# consent decisions fail closed with OPERATOR_AUTH_NOT_PROVISIONED behavior.
PROOFFLEET_OPERATOR_TOKEN=""
PROOFFLEET_SESSION_SECRET=""
# Display label only; authenticated identity is derived server-side from the
# session and is never accepted from the consent request body.
PROOFFLEET_OPERATOR_IDENTITY="operator"

# GCP adapter configuration. Without these, every adapter reports
# NOT_PROVISIONED honestly (see server/adapters/gcp/README.md for exact steps).
GCP_PROJECT_ID=""
GCP_REGION="europe-west1"
ADK_AGENT_ENGINE_ID=""
PROOFFLEET_CLOUDRUN_SERVICE=""
PROOFFLEET_PUBSUB_TOPIC=""
PROOFFLEET_FIRESTORE_COLLECTION=""
PROOFFLEET_SECRET_NAME=""
PROOFFLEET_MODEL_ARMOR_TEMPLATE=""

# Exact Git/source revision injected by the deployment pipeline. Firestore
# proof identities include this value; do not set it to a branch name or
# friendly label. Use the exact immutable revision deployed to Cloud Run.
PROOFFLEET_SOURCE_REVISION=""

# OpenTelemetry export (behind flag; no-op when disabled)
OTEL_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
