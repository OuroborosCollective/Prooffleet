# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- ProofFleet Hardening (SPEC v1) ---

# HMAC secret for evidence block signatures. Without it, blocks are honestly
# sealed with signature=null (no fake signatures).
PROOFFLEET_HMAC_SECRET=""

# GCP adapter configuration. Without these, every adapter reports
# NOT_PROVISIONED honestly (see server/adapters/gcp/README.md for the exact
# provisioning steps per service).
GCP_PROJECT_ID=""
GCP_REGION="europe-west1"
ADK_AGENT_ENGINE_ID=""
PROOFFLEET_CLOUDRUN_SERVICE=""
PROOFFLEET_PUBSUB_TOPIC=""
PROOFFLEET_FIRESTORE_COLLECTION=""
PROOFFLEET_SECRET_NAME=""
PROOFFLEET_MODEL_ARMOR_TEMPLATE=""

# OpenTelemetry export (behind flag; no-op when disabled)
OTEL_ENABLED="false"
OTEL_EXPORTER_OTLP_ENDPOINT=""
